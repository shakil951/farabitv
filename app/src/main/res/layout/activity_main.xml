<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080E">

    <!-- 1. The Fullscreen Video Player -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fill"/>

    <!-- Dim overlay for background contrast -->
    <View
        android:id="@+id/dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#60000000"
        android:visibility="gone"/>

    <!-- 2. Centered Loading Spinner -->
    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:indeterminateTint="#1D9BF0"
        android:indeterminate="true"
        android:visibility="visible"/>

    <!-- 3. Stream Status / Error Alert Banner -->
    <LinearLayout
        android:id="@+id/notification_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="#EE111827"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:elevation="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/notification_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#EF4444"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Failed to load playlist. Reconnecting in 3s..."/>
    </LinearLayout>

    <!-- 4. Global Playback HUD -->
    <RelativeLayout
        android:id="@+id/player_hud_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Bottom channel info banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#E60D1117"
            android:orientation="horizontal"
            android:padding="20dp"
            android:elevation="4dp"
            android:gravity="center_vertical">

            <!-- Playing Channel Logo -->
            <ImageView
                android:id="@+id/hud_channel_logo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_default_channel_logo"
                android:contentDescription="Channel Logo"/>

            <!-- Divider -->
            <View
                android:layout_width="2dp"
                android:layout_height="40dp"
                android:background="#2E3036"
                android:layout_marginHorizontal="20dp"/>

            <!-- Channel info details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hud_channel_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#3B82F6"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="CH-001"/>

                <TextView
                    android:id="@+id/hud_channel_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:text="Discovery Channel"/>
            </LinearLayout>

            <!-- TV Signal Quality Badge / Clock -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hud_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="14:32"/>

                <TextView
                    android:id="@+id/hud_live_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="● LIVE STREAM"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- 5. Glassmorphism Side Panel Overlay for Channels List -->
    <LinearLayout
        android:id="@+id/sidebar_container"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F20D1117"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- App Logo & Info Header of Sidebar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tv_banner"
                android:contentDescription="TV icon"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TV"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/developer_credit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="By Farabi Ahmed Shakil"
                    android:textColor="#3B82F6"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Count Indicator -->
        <TextView
            android:id="@+id/sidebar_channel_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading channels..."
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:layout_marginBottom="20dp"/>

        <!-- Filter tabs: [ALL] [RECENTS STREAMS] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tab_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#3B82F6"
                android:textColor="#FFFFFF"
                android:text="ALL CHANNELS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:focusable="true"/>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <TextView
                android:id="@+id/tab_recent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1F2937"
                android:textColor="#9CA3AF"
                android:text="RECENTS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:focusable="true"/>
        </LinearLayout>

        <!-- The Quick Channel List RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channel_list_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:scrollbarThumbVertical="@android:color/white"
            android:focusable="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp"/>

        <!-- Close hint info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_horizontal"
            android:text="Press BACK to hide | UP/DOWN to scroll"
            android:textColor="#9CA3AF"
            android:textSize="11sp"/>

        <!-- Exit Button -->
        <TextView
            android:id="@+id/btn_exit_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1F2937"
            android:textColor="#EF4444"
            android:text="EXIT APPLICATION"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:focusable="true"/>
    </LinearLayout>

    <!-- 6. Floating Overlay for direct numeric entry -->
    <LinearLayout
        android:id="@+id/numeric_dial_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="#CC10B981"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:elevation="7dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="SWITCHING TO CH: "/>

        <TextView
            android:id="@+id/numeric_dial_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="42"/>
    </LinearLayout>

</FrameLayout>
