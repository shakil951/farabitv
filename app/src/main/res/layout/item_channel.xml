<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channel_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_channel_item_normal"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:focusable="true"
    android:clickable="true">

    <!-- 1. Channel Number Badge -->
    <TextView
        android:id="@+id/item_channel_number"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:textColor="#3D82F6"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginEnd="8dp"
        tools:text="1"/>

    <!-- 2. Channel Logo -->
    <ImageView
        android:id="@+id/item_channel_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_default_channel_logo"
        android:layout_marginEnd="12dp"
        android:contentDescription="Channel Logo"/>

    <!-- 3. Channel Info Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Sky Sports Football"/>

        <TextView
            android:id="@+id/item_channel_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            tools:text="SPORTS"/>
    </LinearLayout>

    <!-- 4. Active Playing Visual Indicator -->
    <ImageView
        android:id="@+id/item_playing_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@android:drawable/presence_video_online"
        android:tint="#10B981"
        android:visibility="gone"
        android:contentDescription="Now Playing"
        tools:ignore="UseAppTint"/>

</LinearLayout>
